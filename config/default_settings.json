DEFAULT_SETTINGS_PATH = Path(__file__).resolve().parents[1] / "config" / "default_settings.json"


class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.settings = self.load_settings()
        self.thread = None
        self.preview_image_path = ""
        self.setWindowTitle("WatermarkTool")
        self.resize(int(self.settings.get("window_width", 1280)), int(self.settings.get("window_height", 800)))
        self.move(int(self.settings.get("window_x", 100)), int(self.settings.get("window_y", 100)))
        self.setup_ui()
        self.apply_settings_to_controls()
        self.setWindowFlags(Qt.WindowType.Window)

    def load_settings(self) -> dict:
        default = json.loads(Path("config/default_settings.json").read_text(encoding="utf-8"))
        user = load_json_config(str(DEFAULT_SETTINGS_PATH))
        merged = default.copy()
        merged.update(user)
        return merged

    def save_settings(self):
        self.settings.update(self.collect_settings())
        self.settings["window_width"] = self.width()
        self.settings["window_height"] = self.height()
        self.settings["window_x"] = self.x()
        self.settings["window_y"] = self.y()
        save_json_config(str(DEFAULT_SETTINGS_PATH), self.settings)

