    def toggle_preview_input(self, enabled: bool):
        if enabled:
            self.choose_preview_image()

    def choose_source_dir(self):
        path = QFileDialog.getExistingDirectory(self, "选择源目录")
        if path:
            self.source_dir_edit.setText(path)

    def choose_output_dir(self):
        path = QFileDialog.getExistingDirectory(self, "选择输出目录")
        if path:
            self.output_dir_edit.setText(path)

    def choose_watermark(self):
        path, _ = QFileDialog.getOpenFileName(self, "选择水印图片", filter="Images (*.png *.jpg *.jpeg *.webp *.bmp *.tif *.tiff)")
        if path:
            self.watermark_path_edit.setText(path)

    def choose_preview_image(self):
        path, _ = QFileDialog.getOpenFileName(self, "选择预览图片", filter="Images (*.png *.jpg *.jpeg *.webp *.bmp *.tif *.tiff)")
        if path:
            self.preview_image_path = path
            self.preview_panel.set_preview(path, "已加载指定预览图片")

    def load_custom_rule(self, checked: bool):
        if not checked:
            return
        path, _ = QFileDialog.getOpenFileName(self, "选择规则文件", filter="JSON (*.json)")
        if not path:
            self.custom_rule_check.setChecked(False)
            return
        try:
            rule = load_rule_file(path)
            ok, message = validate_rule_config(rule)
            if not ok:
                QMessageBox.warning(self, "规则文件错误", message)
                self.custom_rule_check.setChecked(False)
                return
            self.settings.update(merge_rule_config(self.settings, rule))
            self.apply_settings_to_controls()
            self.addTextToLog(f"[INFO] 已加载自定义规则：{path}")
        except Exception as exc:
            QMessageBox.warning(self, "加载规则失败", str(exc))
            self.custom_rule_check.setChecked(False)

    def addTextToLog(self, text: str):
        self.log_edit.append(text)

    def clear_log(self):
        self.log_edit.clear()

    def save_log(self):
        path, _ = QFileDialog.getSaveFileName(self, "保存日志", filter="TXT (*.txt)")
        if path:
            with open(path, "w", encoding="utf-8") as f:
                f.write(self.log_edit.toPlainText())
            self.addTextToLog(f"[INFO] 日志已保存到：{path}")

    def apply_settings_to_controls(self):
        self.source_dir_edit.setText(self.settings.get("source_dir", ""))
        self.output_dir_edit.setText(self.settings.get("output_dir", ""))
        self.watermark_path_edit.setText(self.settings.get("watermark_path", ""))
        self.offset_x_spin.setValue(int(self.settings.get("offset_x", 5)))
        self.offset_y_spin.setValue(int(self.settings.get("offset_y", 5)))
        self.ratio_spin.setValue(float(self.settings.get("watermark_width_ratio", 0.6)))
        self.opacity_spin.setValue(float(self.settings.get("opacity", 0.7)))
        self.resume_check.setChecked(bool(self.settings.get("resume_enabled", True)))
        self.preview_check.setChecked(bool(self.settings.get("use_preview_image", False)))
        self.custom_rule_check.setChecked(bool(self.settings.get("custom_rules_enabled", False)))
        self.output_format_combo.setCurrentText(str(self.settings.get("output_format", "keep")))
        self.auto_quality_check.setChecked(bool(self.settings.get("auto_quality_enabled", False)))
        self.fixed_quality_spin.setValue(int(self.settings.get("fixed_quality", 85)))
        self.target_size_spin.setValue(int(self.settings.get("target_size_kb", 1500)))
        self.quality_step_spin.setValue(int(self.settings.get("quality_step", 5)))
        self.min_quality_spin.setValue(int(self.settings.get("min_quality", 30)))
        self.max_quality_spin.setValue(int(self.settings.get("max_quality", 95)))
        self.add_text_check.setChecked(bool(self.settings.get("add_text_enabled", False)))
        self.text_content_edit.setText(str(self.settings.get("text_content", "Watermark")))
        self.text_position_combo.setCurrentText(str(self.settings.get("text_position", "bottom-right")))
        self.text_font_edit.setText(str(self.settings.get("text_font", "Arial")))
        self.text_size_spin.setValue(int(self.settings.get("text_size", 28)))
        self.text_opacity_spin.setValue(float(self.settings.get("text_opacity", 1.0)))
        self.add_number_check.setChecked(bool(self.settings.get("add_number_enabled", False)))
        self.start_index_spin.setValue(int(self.settings.get("start_index", 1)))
        self.number_digits_spin.setValue(int(self.settings.get("number_digits", 3)))
        self.number_prefix_edit.setText(str(self.settings.get("number_prefix", "")))
        self.number_suffix_edit.setText(str(self.settings.get("number_suffix", "")))
        self.use_template_check.setChecked(bool(self.settings.get("use_template", False)))
        self.template_edit.setText(str(self.settings.get("template_text", "{filename}_{index}{extension}")))
        self.use_script_check.setChecked(bool(self.settings.get("use_advanced_script", False)))
        self.script_edit.setText(str(self.settings.get("advanced_script", "filename + '_' + str(index)")))

        horizontal = str(self.settings.get("horizontal_alignment", "right")).lower()
        if horizontal == "left":
            self.h_left.setChecked(True)
        elif horizontal == "center":
            self.h_center.setChecked(True)
        else:
            self.h_right.setChecked(True)

        vertical = str(self.settings.get("vertical_alignment", "bottom")).lower()
        if vertical == "top":
            self.v_top.setChecked(True)
        elif vertical == "center":
            self.v_center.setChecked(True)
        else:
            self.v_bottom.setChecked(True)

    def collect_settings(self) -> dict:
        settings = {
            "source_dir": self.source_dir_edit.text(),
            "output_dir": self.output_dir_edit.text(),
            "watermark_path": self.watermark_path_edit.text(),
            "horizontal_alignment": "left" if self.h_left.isChecked() else "center" if self.h_center.isChecked() else "right",
            "vertical_alignment": "top" if self.v_top.isChecked() else "center" if self.v_center.isChecked() else "bottom",
            "offset_x": int(self.offset_x_spin.value()),
            "offset_y": int(self.offset_y_spin.value()),
            "watermark_width_ratio": float(self.ratio_spin.value()),
            "opacity": float(self.opacity_spin.value()),
            "resume_enabled": self.resume_check.isChecked(),
            "use_preview_image": self.preview_check.isChecked(),
            "preview_image_path": self.preview_image_path,
            "custom_rules_enabled": self.custom_rule_check.isChecked(),
            "output_format": self.output_format_combo.currentText(),
            "auto_quality_enabled": self.auto_quality_check.isChecked(),
            "fixed_quality": int(self.fixed_quality_spin.value()),
            "target_size_kb": int(self.target_size_spin.value()),
            "quality_step": int(self.quality_step_spin.value()),
            "min_quality": int(self.min_quality_spin.value()),
            "max_quality": int(self.max_quality_spin.value()),
            "add_text_enabled": self.add_text_check.isChecked(),
            "text_content": self.text_content_edit.text(),
            "text_position": self.text_position_combo.currentText(),
            "text_font": self.text_font_edit.text(),
            "text_size": int(self.text_size_spin.value()),
            "text_opacity": float(self.text_opacity_spin.value()),
            "add_number_enabled": self.add_number_check.isChecked(),
            "start_index": int(self.start_index_spin.value()),
            "number_digits": int(self.number_digits_spin.value()),
            "number_prefix": self.number_prefix_edit.text(),
            "number_suffix": self.number_suffix_edit.text(),
            "use_template": self.use_template_check.isChecked(),
            "template_text": self.template_edit.text(),
            "use_advanced_script": self.use_script_check.isChecked(),
            "advanced_script": self.script_edit.text(),
        }
        return settings

    def validate_inputs(self):
        if not self.source_dir_edit.text():
            raise ValueError("请先选择源目录。")
        if not self.output_dir_edit.text():
            raise ValueError("请先选择输出目录。")
        if not self.watermark_path_edit.text():
            raise ValueError("请先选择水印图片。")
        ok, message = validate_source_dir(self.source_dir_edit.text())
        if not ok:
            raise ValueError(message)
        ok, message = check_file_access(self.watermark_path_edit.text())
        if not ok:
            raise ValueError(message)
        if self.preview_check.isChecked() and self.preview_image_path and not os.path.exists(self.preview_image_path):
            raise ValueError("指定预览图片不存在。")

    def start_processing(self):
        try:
            self.validate_inputs()
            self.save_settings()
            settings = self.collect_settings()
            if self.thread is not None:
                return
            self.thread = ProcessingThread(settings)
            self.thread.log.connect(self.addTextToLog)
            self.thread.progress.connect(self.update_progress)
            self.thread.finished.connect(self.on_processing_finished)
            self.thread.run = self.thread.run
            self.thread.start = self.thread.start
            self.thread.start()
            self.addTextToLog("[INFO] 开始批量处理任务。")
        except Exception as exc:
            QMessageBox.warning(self, "参数错误", str(exc))

    def stop_processing(self):
        if self.thread is not None:
            self.thread.stop()
            self.addTextToLog("[WARN] 用户请求停止当前任务。")

    def update_progress(self, current: int, total: int, text: str):
        progress = 0 if total == 0 else int(current / total * 100)
        self.setWindowTitle(f"WatermarkTool - {progress}%")
        self.addTextToLog(f"[PROGRESS] {text}（{current}/{total}）")

    def on_processing_finished(self, data: dict):
        if data.get("error"):
            self.addTextToLog(f"[ERROR] 处理任务异常：{data['error']}")
        self.addTextToLog(f"[INFO] 处理完成。成功：{data.get('success', 0)}，跳过：{data.get('skipped', 0)}，失败：{data.get('failed', 0)}")
        self.thread = None
        self.setWindowTitle("WatermarkTool")

    def refresh_preview(self):
        if self.preview_check.isChecked() and self.preview_image_path:
            self.preview_panel.set_preview(self.preview_image_path, "已加载指定预览图片")
            return
        source_dir = self.source_dir_edit.text()
        if not source_dir:
            self.preview_panel.set_preview(None, "请先选择源目录")
            return
        files = []
        for item in sorted(Path(source_dir).iterdir(), key=lambda x: x.name.lower()):
            if item.is_file() and item.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"}:
                files.append(str(item))
        if not files:
            self.preview_panel.set_preview(None, "源目录中没有可预览图片")
            return
        self.preview_panel.set_preview(files[0], "已加载源目录首张图片作为预览")

    def closeEvent(self, event):
        if self.thread is not None:
            reply = QMessageBox.question(self, "确认退出", "当前任务仍在运行，是否确认退出？", QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
            if reply == QMessageBox.StandardButton.No:
                event.ignore()
                return
        self.save_settings()
        event.accept()


if __name__ == "__main__":
    app = QApplication([])
    window = MainWindow()
    window.show()
    app.exec()
